{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "text2pandas.model-semantic-gold-v1.annotation-v3",
  "title": "Text2Pandas model semantic gold annotation v3",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "qid",
    "question",
    "question_sha256",
    "cohort",
    "selection_digest",
    "primary_stratum",
    "secondary_tags",
    "generation",
    "record_status",
    "status_reason",
    "entities",
    "metrics",
    "periods",
    "basis",
    "unit",
    "operation_tree",
    "output",
    "operands",
    "field_status",
    "source_evidence",
    "ambiguity_alternatives",
    "notes"
  ],
  "properties": {
    "schema_version": {"const": 3},
    "release_id": {"const": "MODEL_SEMANTIC_GOLD_V1"},
    "qid": {"type": "integer", "minimum": 1},
    "question": {"type": "string", "minLength": 1},
    "question_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "cohort": {"enum": ["HEADLINE_CORE", "DIAGNOSTIC_SUPPLEMENT", "RESERVE"]},
    "selection_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "primary_stratum": {"type": ["string", "null"]},
    "secondary_tags": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "generation": {"$ref": "#/$defs/generation"},
    "record_status": {"enum": ["RESOLVED", "AMBIGUOUS", "UNRESOLVED"]},
    "status_reason": {
      "type": ["string", "null"],
      "enum": [
        null,
        "QUESTION_AMBIGUITY",
        "MISSING_EVIDENCE",
        "MISSING_VOCABULARY",
        "SCHEMA_LIMITATION",
        "GENERATION_FAILURE"
      ]
    },
    "entities": {"type": "array", "items": {"$ref": "#/$defs/entity"}},
    "metrics": {"type": "array", "items": {"$ref": "#/$defs/metric"}},
    "periods": {"type": "array", "items": {"$ref": "#/$defs/period"}},
    "basis": {"$ref": "#/$defs/basis"},
    "unit": {"$ref": "#/$defs/unit"},
    "operation_tree": {
      "anyOf": [{"$ref": "#/$defs/operation_tree"}, {"type": "null"}]
    },
    "output": {"anyOf": [{"$ref": "#/$defs/output"}, {"type": "null"}]},
    "operands": {"type": "array", "items": {"$ref": "#/$defs/operand"}},
    "field_status": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entities",
        "metrics",
        "periods",
        "basis",
        "unit",
        "operation_tree",
        "output",
        "operands"
      ],
      "properties": {
        "entities": {"$ref": "#/$defs/field_status"},
        "metrics": {"$ref": "#/$defs/field_status"},
        "periods": {"$ref": "#/$defs/field_status"},
        "basis": {"$ref": "#/$defs/field_status"},
        "unit": {"$ref": "#/$defs/field_status"},
        "operation_tree": {"$ref": "#/$defs/field_status"},
        "output": {"$ref": "#/$defs/field_status"},
        "operands": {"$ref": "#/$defs/field_status"}
      }
    },
    "source_evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    },
    "ambiguity_alternatives": {
      "type": "array",
      "items": {"$ref": "#/$defs/ambiguity_alternative"}
    },
    "notes": {"type": ["string", "null"]}
  },
  "$defs": {
    "field_status": {
      "enum": ["RESOLVED", "AMBIGUOUS", "UNRESOLVED", "NOT_APPLICABLE"]
    },
    "span": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "start", "end"],
      "properties": {
        "text": {"type": "string", "minLength": 1},
        "start": {"type": "integer", "minimum": 0},
        "end": {"type": "integer", "minimum": 1}
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gold_mode",
        "annotation_source",
        "human_review",
        "cross_model_review",
        "model_id",
        "model_digest",
        "prompt_version",
        "prompt_sha256",
        "response_sha256",
        "attempt_count"
      ],
      "properties": {
        "gold_mode": {"const": "MODEL_GOLD"},
        "annotation_source": {"const": "LLM"},
        "human_review": {"const": false},
        "cross_model_review": {"const": false},
        "model_id": {"type": "string", "minLength": 1},
        "model_digest": {"type": "string", "minLength": 1},
        "prompt_version": {"const": "model-semantic-gold-prompt-v1"},
        "prompt_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "response_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "attempt_count": {"type": "integer", "minimum": 1, "maximum": 3}
      }
    },
    "entity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "entity_ref",
        "mention",
        "canonical_ref",
        "resolution_status",
        "entity_type",
        "semantic_role"
      ],
      "properties": {
        "entity_ref": {"type": "string", "pattern": "^e[1-9][0-9]*$"},
        "mention": {"$ref": "#/$defs/span"},
        "canonical_ref": {"type": ["string", "null"]},
        "resolution_status": {"enum": ["RESOLVED", "AMBIGUOUS", "UNRESOLVED"]},
        "entity_type": {
          "enum": [
            "COMPANY",
            "SUBSIDIARY",
            "INVESTEE",
            "PERSON",
            "INDUSTRY",
            "SEGMENT",
            "GROUP",
            "OTHER"
          ]
        },
        "semantic_role": {
          "enum": [
            "REPORTING_ENTITY",
            "COMPARISON_ENTITY",
            "GROUP_MEMBER",
            "INVESTEE",
            "SUBSIDIARY",
            "PARENT_ENTITY",
            "POPULATION_MEMBER",
            "FILTER_ENTITY",
            "RANK_ENTITY",
            "OTHER"
          ]
        }
      }
    },
    "metric": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric_ref",
        "phrase",
        "concept_id",
        "concept_status",
        "reported_or_derived",
        "definition_version",
        "variant"
      ],
      "properties": {
        "metric_ref": {"type": "string", "pattern": "^m[1-9][0-9]*$"},
        "phrase": {"$ref": "#/$defs/span"},
        "concept_id": {"type": ["string", "null"]},
        "concept_status": {"enum": ["RESOLVED", "AMBIGUOUS", "UNRESOLVED"]},
        "reported_or_derived": {"enum": ["REPORTED", "DERIVED", "UNKNOWN"]},
        "definition_version": {"const": "semantic-metric-concepts-model-v1"},
        "variant": {"type": ["string", "null"]}
      }
    },
    "period": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "period_ref",
        "mention",
        "year",
        "quarter",
        "date",
        "point",
        "role",
        "explicit"
      ],
      "properties": {
        "period_ref": {"type": "string", "pattern": "^p[1-9][0-9]*$"},
        "mention": {"anyOf": [{"$ref": "#/$defs/span"}, {"type": "null"}]},
        "year": {"type": ["integer", "null"], "minimum": 1900, "maximum": 2100},
        "quarter": {"type": ["integer", "null"], "minimum": 1, "maximum": 4},
        "date": {
          "type": ["string", "null"],
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
        },
        "point": {"enum": ["PERIOD", "OPENING", "CLOSING", "INSTANT", "UNKNOWN"]},
        "role": {
          "enum": [
            "VALUE",
            "CURRENT",
            "PREVIOUS",
            "START",
            "END",
            "RANK_DOMAIN",
            "FILTER_DOMAIN"
          ]
        },
        "explicit": {"type": "boolean"}
      }
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "explicit"],
      "properties": {
        "value": {"enum": ["CONSOLIDATED", "SEPARATE", "UNSPECIFIED"]},
        "explicit": {"type": "boolean"}
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dimension", "scale_exponent", "currency", "explicit"],
      "properties": {
        "dimension": {
          "enum": ["MONEY", "PERCENT", "PERCENT_POINT", "RATIO", "COUNT", "SHARES", "UNKNOWN"]
        },
        "scale_exponent": {
          "type": ["integer", "null"],
          "enum": [null, 0, 3, 6, 9, 11, 12]
        },
        "currency": {"type": ["string", "null"]},
        "explicit": {"type": "boolean"}
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape"],
      "properties": {
        "shape": {"enum": ["SCALAR", "ENTITY", "PERIOD", "COUNT", "TABLE", "SET", "BOOLEAN", "OTHER"]}
      }
    },
    "literal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "value", "comparator", "unit"],
      "properties": {
        "kind": {"enum": ["NUMBER", "PERCENT", "RATIO", "COUNT", "TEXT", "BOOLEAN"]},
        "value": {"type": "string", "minLength": 1},
        "comparator": {"enum": ["EQ", "NE", "GT", "GTE", "LT", "LTE", "IN", "NOT_IN"]},
        "unit": {"anyOf": [{"$ref": "#/$defs/unit"}, {"type": "null"}]}
      }
    },
    "operand": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "operand_ref",
        "role",
        "metric_ref",
        "entity_ref",
        "period_ref",
        "basis",
        "unit",
        "literal"
      ],
      "properties": {
        "operand_ref": {"type": "string", "pattern": "^o[1-9][0-9]*$"},
        "role": {"$ref": "#/$defs/operand_role"},
        "metric_ref": {"type": ["string", "null"]},
        "entity_ref": {"type": ["string", "null"]},
        "period_ref": {"type": ["string", "null"]},
        "basis": {"anyOf": [{"$ref": "#/$defs/basis"}, {"type": "null"}]},
        "unit": {"anyOf": [{"$ref": "#/$defs/unit"}, {"type": "null"}]},
        "literal": {"anyOf": [{"$ref": "#/$defs/literal"}, {"type": "null"}]}
      }
    },
    "operand_role": {
      "enum": [
        "VALUE",
        "LEFT",
        "RIGHT",
        "MINUEND",
        "SUBTRAHEND",
        "NUMERATOR",
        "DENOMINATOR",
        "NEW",
        "OLD",
        "SUMMAND",
        "RANK_KEY",
        "PROJECTED_VALUE",
        "FILTER_OPERAND",
        "FILTER_THRESHOLD"
      ]
    },
    "operation_input": {
      "type": "object",
      "additionalProperties": false,
      "required": ["role", "source_kind", "source_ref"],
      "properties": {
        "role": {"$ref": "#/$defs/operand_role"},
        "source_kind": {"enum": ["OPERAND", "NODE"]},
        "source_ref": {"type": "string", "pattern": "^[on][1-9][0-9]*$"}
      }
    },
    "operation_tree": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "node", "inputs", "children"],
      "properties": {
        "node_id": {"type": "string", "pattern": "^n[1-9][0-9]*$"},
        "node": {
          "enum": [
            "LOOKUP",
            "ADD",
            "SUBTRACT",
            "DIVIDE",
            "GROWTH",
            "PERCENT_CHANGE",
            "SUM",
            "AVERAGE",
            "COUNT",
            "MINIMUM",
            "MAXIMUM",
            "ARGMIN",
            "ARGMAX",
            "SELECT_AT_ARG",
            "FILTER",
            "MEDIAN",
            "OTHER"
          ]
        },
        "inputs": {"type": "array", "items": {"$ref": "#/$defs/operation_input"}},
        "children": {"type": "array", "items": {"$ref": "#/$defs/operation_tree"}}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "context_label", "status"],
      "properties": {
        "source_path": {"type": ["string", "null"]},
        "context_label": {"type": ["string", "null"]},
        "status": {"enum": ["LOCATED", "NOT_LOCATED", "NOT_APPLICABLE"]}
      }
    },
    "ambiguity_alternative": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alternative_id", "description"],
      "properties": {
        "alternative_id": {"type": "string", "pattern": "^a[1-9][0-9]*$"},
        "description": {"type": "string", "minLength": 1}
      }
    }
  }
}
