# Python bytecode and build output
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/

# Virtual environments
.venv/
.venv-*/
venv/
env/

# IDE and OS files
.DS_Store
.idea/
.vscode/
*.swp
*.swo

# Local agent configuration
.agents/
.codex/
.gemini/

# Runtime data. Keep only documentation and machine-readable identity metadata.
/data/**
!/data/**/
!/data/README.md
!/data/**/README.md
!/data/**/manifest.json
!/data/**/*.sha256
# Small reviewed evaluation fixtures are source-like curated data.
!/data/curated/evaluation/**

# Generated artifacts. Large payloads are reproducible from source + manifests.
/artifacts/**
!/artifacts/**/
!/artifacts/README.md
!/artifacts/**/README.md
!/artifacts/**/manifest.json
!/artifacts/**/*.sha256

# External/reference repositories are materialized locally, never vendored as
# nested Git repositories.
/vendor/**
!/vendor/README.md
!/vendor/**/
!/vendor/**/manifest.json

# Large/generated payloads regardless of location
*.db
*.db-journal
*.sqlite
*.sqlite-journal
*.parquet
*.zip
*.tgz
*.tar.gz
*.whl

# Run and packaging scratch
reports/
wheelhouse*/
_tmp*/
tmp/
_TO_DELETE/
_to_delete/
to_read/
verify_out/
sync_*/
.dp_write_probe
.fuse_hidden*

# Finder duplicate folders and local review environments
*[0-9][0-9].[0-9][0-9].[0-9][0-9]/
.venv-review/
.venv-build/
ops/environment/review_env_actual.json
