# Sandbox container for executing LLM-generated Pandas code
# SECURITY: No network, limited resources, read-only filesystem

FROM python:3.12-slim

# Install data science libraries ONLY
RUN pip install --no-cache-dir \
    pandas==2.2.3 \
    numpy==1.26.4 \
    matplotlib==3.9.3 \
    plotly==5.24.1 \
    openpyxl==3.1.5 \
    pyarrow==18.1.0 \
    && pip cache purge

# Remove network tools for extra security
RUN apt-get update && apt-get purge -y curl wget && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# Create non-root user
RUN useradd -m -s /bin/bash sandbox
USER sandbox

WORKDIR /workspace

# Default command: execute a Python script
ENTRYPOINT ["python"]
